{
  "$schema": "https://schema.tauri.app/capability/v1.json",
  "identifier": "main-capability",
  "description": "Capabilities for main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "clipboard:default",
    "dialog:default",
    "fs:default",
    "fs:allow-app-data",
    "fs:allow-app-data-recursive",
    "global-shortcut:default",
    "notification:default",
    "path:default",
    "process:default",
    "shell:default",
    "sql:default",
    "store:default",
    "tray:default",
    "window:default"
  ]
}