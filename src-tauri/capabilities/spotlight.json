{
  "$schema": "https://schema.tauri.app/capability/v1.json",
  "identifier": "spotlight-capability",
  "description": "Minimal capabilities for spotlight window",
  "windows": ["spotlight"],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:event:default",
    "core:image:default",
    "core:menu:default",
    "core:path:default",
    "core:resources:default",
    "core:tray:default",
    "core:webview:default",
    "core:window:default",
    "clipboard-manager:default",
    "dialog:default",
    "fs:default",
    "fs:scope-appdata-recursive",
    "fs:scope-app-recursive",
    "global-shortcut:default",
    "http:default",
    "notification:default",
    "opener:default",
    "shell:default",
    "sql:default",
    "store:default"
  ]
}
