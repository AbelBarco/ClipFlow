{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:1420",
    "distDir": "../build"
  },
  "package": {
    "productName": "ClipFlow",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "clipboard": {
        "readText": true,
        "writeText": true,
        "readImage": true,
        "writeImage": true
      },
      "dialog": {
        "all": true
      },
      "fs": {
        "all": true,
        "scope": ["$APPDATA/clipflow/**", "$APPDATA/clipflow/images/**"]
      },
      "globalShortcut": {
        "all": true
      },
      "notification": {
        "all": true
      },
      "path": {
        "all": true
      },
      "process": {
        "all": true
      },
      "shell": {
        "all": true,
        "scope": {
          "allow": ["wl-copy", "xclip", "wl-paste", "tesseract"]
        }
      },
      "sql": {
        "all": true
      },
      "store": {
        "all": true
      },
      "tray": {
        "all": true
      },
      "window": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.clipflow.app",
      "publisher": "ClipFlow",
      "shortDescription": "Lightweight cross-platform clipboard manager",
      "longDescription": "ClipFlow is a lightweight, cross-platform clipboard manager that lives in your system tray. It saves everything you copy (text, code, images, colors) and lets you retrieve it instantly with a global shortcut.",
      "copyright": "Copyright © 2024 ClipFlow Contributors",
      "category": "DeveloperTool",
      "license": "MIT",
      "licenseFile": "../LICENSE",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": "http://timestamp.digicert.com",
        "webviewInstallMode": {
          "type": "downloadBootstrapper"
        }
      },
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null,
        "minimumSystemVersion": "10.15"
      },
      "linux": {
        "deb": {
          "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "librsvg2-common", "tesseract-ocr"]
        },
        "appimage": {
          "bundleMediaFramework": true
        }
      }
    },
    "macOSPrivateApi": true,
    "macOS": {
      "fullsizeContentView": true,
      "disableToolbar": true
    },
    "plugins": {
      "sql": {
        "preload": ["sqlite:clipflow.db"]
      },
      "tray": {
        "icon": "icons/32x32.png"
      }
    },
    "windows": [
      {
        "label": "main",
        "url": "main",
        "title": "ClipFlow",
        "width": 520,
        "height": 600,
        "minWidth": 400,
        "minHeight": 400,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "center": true
      },
      {
        "label": "spotlight",
        "url": "spotlight",
        "title": "ClipFlow Spotlight",
        "width": 560,
        "height": 400,
        "minWidth": 400,
        "minHeight": 300,
        "maxWidth": 800,
        "maxHeight": 800,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true
      },
      {
        "label": "settings",
        "url": "settings",
        "title": "ClipFlow Settings",
        "width": 520,
        "height": 500,
        "minWidth": 400,
        "minHeight": 400,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}